# Set these before building/running the app on a physical phone. Use HTTPS
# service URLs in production, or the computer's LAN IPv4 address on local Wi-Fi.
# EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_TRANSLATION_URL=http://localhost:8001
# For a physical phone, set both URLs to the computer's LAN address and set
# AUDIO_PUBLIC_BASE_URL to the same translation-service URL in DoAn/BE/.env.
# EXPO_PUBLIC_API_URL=http://<COMPUTER_LAN_IP>:8000
# EXPO_PUBLIC_TRANSLATION_URL=http://<COMPUTER_LAN_IP>:8001
# AUDIO_PUBLIC_BASE_URL=http://<COMPUTER_LAN_IP>:8001
